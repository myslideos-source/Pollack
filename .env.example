# Supabase — Project Settings → API in deinem Supabase-Projekt.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nur serverseitig verwendet (Admin-Nutzer einladen, Storage-Admin-Operationen). Project
# Settings → API → "service_role" (geheim). NIEMALS mit NEXT_PUBLIC_ Präfix versehen oder im
# Browser verwenden.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: E-Mail-Versand über Resend (resend.com). Ohne Wert wird der Versand übersprungen,
# es passiert kein Fehler — die Anfrage wird trotzdem in der Datenbank gespeichert.
RESEND_API_KEY=

# Optional: Absenderadresse für ausgehende E-Mails (muss bei Resend als Domain verifiziert
# sein). Fällt ohne Wert auf eine Resend-Testadresse zurück.
RESEND_FROM_EMAIL=

# Optional: Live Google-Bewertung auf der Startseite (Places API "New"). Ohne Werte zeigt die
# Seite weiterhin die zuletzt bestätigten statischen Zahlen.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
